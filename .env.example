# Copy to .env and fill in. Never commit .env.
#
# OpenFactory makes all model calls through Claude Code, using your Claude
# subscription login (run `claude` once and log in). No API key is needed.
#
# Do NOT set ANTHROPIC_API_KEY: if it is set, Claude Code uses it instead of
# your subscription and you are billed at API rates.

# Optional: model passed to `claude --model` for planner and classifier calls
OPENFACTORY_MODEL=

# Optional: where OpenFactory keeps its SQLite DB, worktrees and run logs
OPENFACTORY_HOME=.openfactory